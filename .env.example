# Database configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/teamflow?schema=public"

# NextAuth configuration
# Generate a secret via `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-32-character-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# AI / NLP integration (Groq Cloud)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=""

# Stripe payments (Optional for testing)
# Test keys available at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
