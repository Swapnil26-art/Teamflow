# Database configuration
# Use an ONLINE PostgreSQL for Vercel deployment. Recommended: Neon (https://neon.tech)
# 1) Create a Neon project -> copy the connection strings
# 2) DATABASE_URL = pooled string (host contains "-pooler"), used by the app
# 3) DIRECT_URL   = direct/unpooled string, used by Prisma CLI (db push/seed)
# 4) Add BOTH to your Vercel project Settings -> Environment Variables BEFORE deploying
# Local dev example: postgresql://postgres:postgres@localhost:5432/teamflow?schema=public
DATABASE_URL=""
DIRECT_URL=""

# NextAuth configuration
# Generate a secret via `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-32-character-auth-secret-key-here"
# For Vercel, set this to your deployed domain, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# AI / NLP integration (Groq Cloud)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: override the model. Defaults to openai/gpt-oss-120b and falls
# back to other available Groq models if the configured one is retired.
GROQ_MODEL="openai/gpt-oss-120b"

# Stripe payments (Optional for testing)
# Test keys available at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
